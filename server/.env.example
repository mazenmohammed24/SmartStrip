PORT=4001
JWT_SECRET=change-me-to-a-long-random-string
DRIVER=mock
VOLTRA_ACCESS_TOKEN=
# Refresh token issued by the Voltra portal. Required for automatic access-token
# renewal; without it the driver cannot recover from an expired access token.
# Tokens are normally saved at runtime via POST /api/settings/voltra-tokens.
VOLTRA_REFRESH_TOKEN=
VOLTRA_BASE_URL=https://toi.ommeq.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
