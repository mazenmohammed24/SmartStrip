PORT=4001
DRIVER=mock
VOLTRA_ACCESS_TOKEN=
# Refresh token issued by the Voltra portal. Required for automatic access-token
# renewal; without it the driver cannot recover from an expired access token.
# Tokens are normally saved at runtime via POST /api/settings/voltra-tokens.
VOLTRA_REFRESH_TOKEN=
VOLTRA_BASE_URL=https://toi.ommeq.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# --- Direct MTTL-W01 driver (DRIVER=mttl) ---
# The strip dials THIS server on MTTL_DEVICE_PORT, so no port forwarding on your
# home router is ever needed. The device port is fixed at 10086 by the strip's
# firmware; treat it as read-only.
MTTL_DEVICE_PORT=10086
MTTL_POLL_INTERVAL_MS=5000
# The IPv4 the strip should be provisioned with. Set this when the server is hosted
# somewhere the strip can reach by a specific address (a VPS public IP, for example)
# and the automatic LAN-IP detection would pick the wrong one.
MTTL_ADVERTISE_IP=
# The strip's own setup access point, used only while provisioning.
MTTL_SETUP_HOST=192.168.1.1
